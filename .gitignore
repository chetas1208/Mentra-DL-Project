# Android
*.apk
*.aab
.gradle/
local.properties
*.iml
.idea/
build/
captures/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets
*.env
.env
*accesskey*
*access_key*

# OS
.DS_Store

# Third-party repos (cloned for reference, not vendored into our history —
# see docs/MENTRA_SDK_NOTES.md for the exact commit used)
vendor/

# Training artifacts -- checkpoints/logs/datasets are large binaries that
# don't belong in git history. Small result summaries (JSON/PNG) under
# evaluation/results/ ARE tracked -- those are the actual evidence, not bulk
# data.
training/checkpoints/
training/runs/
training/logs/
training/geowearnet/cache/
training/geowearnet/runs/
training/geowearnet/export/
training/geowearnet/mmcsg/*
!training/geowearnet/mmcsg/frozen/
!training/geowearnet/mmcsg/frozen/**
server/logs/
logs/

# Local-machine-only config (e.g. resolved absolute paths to large external
# datasets like MMCSG). Never commit an absolute path to another machine.
configs/*.local.json
evaluation/manifests/*.npz
evaluation/results/*.npz
/models/
