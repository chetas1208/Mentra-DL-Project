# Mentra remote audio transport config (docs/MENTRA_REMOTE_AUDIO.md)
# Copy to .env and fill in your actual Tailscale hostname/IP. Never commit .env itself.

MENTRA_AUDIO_TRANSPORT=remote          # local | remote
MENTRA_REMOTE_HOST=mentra-gpu          # Tailscale MagicDNS hostname, or a tailnet IPv4 (100.x.x.x)
MENTRA_REMOTE_PORT=19100

MENTRA_AUDIO_CODEC=auto                # auto | pcm16 | lc3  (lc3 is scaffolded, not implemented yet)

MENTRA_AUDIO_QUEUE_MS=250              # bounded edge-side send queue depth

MENTRA_JITTER_BUFFER_MS=30             # target smoothing cushion
MENTRA_JITTER_MAX_MS=100               # hard ceiling before force-releasing past a gap

MENTRA_RECONNECT_INITIAL_MS=250
MENTRA_RECONNECT_MAX_MS=5000

MENTRA_HEARTBEAT_INTERVAL_MS=5000
MENTRA_DEAD_CONNECTION_MS=15000

# Server-side bind address. Should be your Tailscale interface IP, NOT 0.0.0.0.
# Run `tailscale ip -4` on the server to find it.
MENTRA_SERVER_BIND_HOST=100.x.x.x
